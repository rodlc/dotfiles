#!/bin/bash
#
# bw-push - Detect local changes and guide user to update Bitwarden
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/.bw-lib.sh"

ensure_rbw

echo "📤 Checking local → Bitwarden sync status..."
echo ""

# === ~/.env sync ===
if [[ ! -f "$ENV_FILE" ]]; then
    echo "⏭️  $ENV_FILE not found. Skipping env sync."
else
    if ! rbw get "$BW_ITEM_SECRETS" &>/dev/null; then
        # Item doesn't exist in Bitwarden
        echo "┌─────────────────────────────────────────────────────────────┐"
        echo "│ 📝 .env : Bitwarden item not found                         │"
        echo "└─────────────────────────────────────────────────────────────┘"
        echo ""
        echo "► Action required:"
        echo "  1. Open Bitwarden app"
        echo "  2. Create a new secure note named '$BW_ITEM_SECRETS'"
        echo "  3. Copy and paste the content from the file below"
        echo ""
        ${EDITOR:-nano} "$ENV_FILE"
    else
        # Compare local vs Bitwarden (rbw sync already called by ensure_rbw above)
        bw_content=$(rbw get "$BW_ITEM_SECRETS" 2>/dev/null)
        local_content=$(cat "$ENV_FILE")

        if [[ "$bw_content" == "$local_content" ]]; then
            echo "✅ .env in sync"
            touch "$HOME/.env.bw-synced"
        else
            echo "┌─────────────────────────────────────────────────────────────┐"
            echo "│ ⚠️  .env : local ≠ Bitwarden                                │"
            echo "└─────────────────────────────────────────────────────────────┘"
            echo ""
            echo "Diff (local vs Bitwarden):"
            diff -u <(echo "$bw_content" | sed 's/=.*/=****/') <(echo "$local_content" | sed 's/=.*/=****/') || true
            echo ""
            echo "► Action required:"
            echo "  1. Review the changes in your editor"
            echo "  2. Copy the content you want to push"
            echo "  3. Open Bitwarden app → '$BW_ITEM_SECRETS' → paste"
            echo ""
            ${EDITOR:-nano} "$ENV_FILE"

            rbw sync 2>/dev/null
            bw_content_after=$(rbw get "$BW_ITEM_SECRETS" 2>/dev/null)
            local_content_after=$(cat "$ENV_FILE")
            if [[ "$bw_content_after" == "$local_content_after" ]]; then
                echo "✅ .env now in sync"
                touch "$HOME/.env.bw-synced"
            else
                echo "⚠️  .env still differs — re-run bw-push after updating Bitwarden"
            fi
        fi
    fi
fi

echo ""

# === SSH keys sync ===
for i in "${!SSH_BW_NAMES[@]}"; do
    bw_name="${SSH_BW_NAMES[$i]}"
    ssh_key="${SSH_LOCAL_PATHS[$i]}"

    if [[ ! -f "$ssh_key" ]]; then
        echo "⏭️  $ssh_key not found. Skipping $bw_name sync."
    else
        get_ssh_key_rc=0
        get_ssh_key "$bw_name" &>/dev/null || get_ssh_key_rc=$?

        if [[ $get_ssh_key_rc -eq 2 ]]; then
            # Multiple entries with same name
            echo "┌─────────────────────────────────────────────────────────────┐"
            echo "│ ⚠️  $bw_name : multiple Bitwarden entries found             │"
            echo "└─────────────────────────────────────────────────────────────┘"
            echo ""
            echo "► Action required:"
            echo "  1. Open Bitwarden Desktop → search '$bw_name'"
            echo "  2. Delete the duplicate entry"
            echo "  3. Re-run bw-push"
        elif [[ $get_ssh_key_rc -ne 0 ]]; then
            # Item absent
            local_fp=$(ssh-keygen -lf "$ssh_key" 2>/dev/null | awk '{print $2}' || true)
            echo "┌─────────────────────────────────────────────────────────────┐"
            echo "│ 🔑 $bw_name : Bitwarden item not found                     │"
            echo "└─────────────────────────────────────────────────────────────┘"
            echo ""
            echo "Local fingerprint: $local_fp"
            echo ""
            cat "$ssh_key" | pbcopy
            echo "► Action required (private key copied to clipboard):"
            echo "  1. Open Bitwarden Desktop"
            echo "  2. + New Item → Type: SSH Key → Name: '$bw_name'"
            echo "  3. Paste private key (already in clipboard)"
            echo "  4. Save"
        else
            # Item found — compare
            bw_key=$(get_ssh_key "$bw_name")
            local_key=$(cat "$ssh_key")

            if [[ "$bw_key" == "$local_key" ]]; then
                pub_file="${ssh_key}.pub"
                if [[ -f "$pub_file" ]]; then
                    bw_pub=$(get_ssh_pub "$bw_name" 2>/dev/null || true)
                    local_pub=$(cat "$pub_file")
                    if [[ -n "$bw_pub" && "$bw_pub" != "$local_pub" ]]; then
                        echo "⚠️  $bw_name : public key diverged in Bitwarden"
                    else
                        echo "✅ $bw_name in sync"
                    fi
                else
                    echo "✅ $bw_name in sync"
                fi
            else
                local_fp=$(ssh-keygen -lf "$ssh_key" 2>/dev/null | awk '{print $2}' || true)
                if [[ -n "$bw_key" ]]; then
                    bw_fp=$(echo "$bw_key" | ssh-keygen -lf /dev/stdin 2>/dev/null | awk '{print $2}' || true)
                else
                    bw_fp="(empty)"
                fi

                echo "┌─────────────────────────────────────────────────────────────┐"
                echo "│ ⚠️  $bw_name : local ≠ Bitwarden                            │"
                echo "└─────────────────────────────────────────────────────────────┘"
                echo ""
                echo "Local:     $local_fp"
                echo "Bitwarden: $bw_fp"
                echo ""
                cat "$ssh_key" | pbcopy
                echo "► Action required (private key copied to clipboard):"
                echo "  1. Open Bitwarden Desktop → '$bw_name'"
                echo "  2. Paste updated private key (already in clipboard)"
                echo "  3. Save"
            fi
        fi
    fi
    echo ""
done

echo ""
echo "✅ Status check complete"


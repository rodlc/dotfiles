#!/bin/bash
#
# bw-pull - Detect Bitwarden changes and guide user to update local
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/.bw-lib.sh"

ensure_rbw

echo "📥 Checking Bitwarden → local sync status..."
echo ""

# === ~/.env sync ===
if ! rbw get "$BW_ITEM_SECRETS" &>/dev/null; then
    echo "❌ '$BW_ITEM_SECRETS' not found in Bitwarden"
else
    bw_content=$(rbw get "$BW_ITEM_SECRETS")

    if [[ ! -f "$ENV_FILE" ]]; then
        # Local file doesn't exist
        echo "┌─────────────────────────────────────────────────────────────┐"
        echo "│ 📝 .env : local file not found                             │"
        echo "└─────────────────────────────────────────────────────────────┘"
        echo ""
        echo "► Action required:"
        echo "  1. Paste the content from Bitwarden → '$BW_ITEM_SECRETS'"
        echo "  2. Don't forget to add WORKSPACE_DIR if needed"
        echo ""
        touch "$ENV_FILE" && chmod 600 "$ENV_FILE"
        ${EDITOR:-nano} "$ENV_FILE"
    else
        # Compare Bitwarden vs local
        local_content=$(cat "$ENV_FILE")
        if [[ "$bw_content" == "$local_content" ]]; then
            echo "✅ .env in sync"
        else
            echo "┌─────────────────────────────────────────────────────────────┐"
            echo "│ ⚠️  .env : Bitwarden ≠ local                                │"
            echo "└─────────────────────────────────────────────────────────────┘"
            echo ""
            echo "Diff (local vs Bitwarden):"
            diff -u <(echo "$local_content") <(echo "$bw_content") || true
            echo ""
            echo "► Action required:"
            echo "  1. Review the changes in your editor"
            echo "  2. Update ~/.env with content from Bitwarden"
            echo ""
            ${EDITOR:-nano} "$ENV_FILE"
        fi
    fi
fi

echo ""

# === SSH key sync ===
SSH_KEY="$HOME/.ssh/id_ed25519_rodlc"

if ! rbw get "$BW_ITEM_SSH" &>/dev/null; then
    echo "❌ '$BW_ITEM_SSH' not found in Bitwarden"
else
    bw_key=$(rbw get "$BW_ITEM_SSH")

    if [[ -z "$bw_key" ]]; then
        echo "⚠️  SSH private key empty in Bitwarden"
    elif [[ ! -f "$SSH_KEY" ]]; then
        # Local SSH key doesn't exist - show fingerprint and ask confirmation
        bw_fp=$(echo "$bw_key" | ssh-keygen -lf /dev/stdin 2>/dev/null | awk '{print $2}')
        echo "┌─────────────────────────────────────────────────────────────┐"
        echo "│ 🔑 SSH Key : local file not found                          │"
        echo "└─────────────────────────────────────────────────────────────┘"
        echo ""
        echo "Bitwarden fingerprint: $bw_fp"
        echo ""
        echo "► Action required:"
        echo "  1. Verify fingerprint matches your key"
        echo "  2. Press Enter to restore from Bitwarden, or Ctrl+C to cancel"
        read -r

        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
        echo "$bw_key" > "$SSH_KEY"
        chmod 600 "$SSH_KEY"
        ssh-add --apple-use-keychain "$SSH_KEY" 2>/dev/null || true
        echo "  ✅ SSH key restored to $SSH_KEY"
    else
        # Compare keys
        local_key=$(cat "$SSH_KEY")
        if [[ "$bw_key" == "$local_key" ]]; then
            echo "✅ SSH key in sync"
        else
            local_fp=$(ssh-keygen -lf "$SSH_KEY" 2>/dev/null | awk '{print $2}')
            bw_fp=$(echo "$bw_key" | ssh-keygen -lf /dev/stdin 2>/dev/null | awk '{print $2}')

            echo "┌─────────────────────────────────────────────────────────────┐"
            echo "│ ⚠️  SSH Key : Bitwarden ≠ local                             │"
            echo "└─────────────────────────────────────────────────────────────┘"
            echo ""
            echo "Bitwarden: $bw_fp"
            echo "Local:     $local_fp"
            echo ""
            echo "► Action required:"
            echo "  1. Review fingerprints above"
            echo "  2. Backup current: cp $SSH_KEY $SSH_KEY.backup.\$(date +%Y%m%d)"
            echo "  3. Press Enter to restore from Bitwarden, or Ctrl+C to cancel"
            read -r

            cp "$SSH_KEY" "$SSH_KEY.backup.$(date +%Y%m%d)" 2>/dev/null || true
            echo "$bw_key" > "$SSH_KEY"
            chmod 600 "$SSH_KEY"
            ssh-add --apple-use-keychain "$SSH_KEY" 2>/dev/null || true
            echo "  ✅ SSH key restored from Bitwarden"
        fi
    fi
fi

echo ""

# === GPG key sync ===
if ! rbw get "$BW_ITEM_GPG" &>/dev/null; then
    echo "⚠️  '$BW_ITEM_GPG' not found in Bitwarden (optional)"
else
    bw_gpg=$(rbw get "$BW_ITEM_GPG")
    if [[ -z "$bw_gpg" ]]; then
        echo "⚠️  GPG key empty in Bitwarden"
    else
        # Check if key already imported
        existing_fp=$(echo "$bw_gpg" | gpg --import-options show-only --import 2>/dev/null | grep -m1 "sec" | awk '{print $2}' | cut -d'/' -f2)
        if gpg --list-secret-keys "$existing_fp" &>/dev/null 2>&1; then
            echo "✅ GPG key already imported ($existing_fp)"
        else
            # Show fingerprint and ask confirmation before import
            echo "┌─────────────────────────────────────────────────────────────┐"
            echo "│ 🔐 GPG Key : importing from Bitwarden                      │"
            echo "└─────────────────────────────────────────────────────────────┘"
            echo ""
            echo "Fingerprint: $existing_fp"
            echo ""
            echo "► Action required:"
            echo "  1. Verify fingerprint matches your key"
            echo "  2. Press Enter to import, or Ctrl+C to cancel"
            read -r

            echo "$bw_gpg" | gpg --batch --import
            echo "  ✅ GPG key imported"
        fi
    fi
fi

echo ""
echo "✅ Status check complete"

# Update marker for MOTD (indicates last sync check)
touch "$HOME/.env.bw-synced"

{
  "mcpServers": {
    "notion-rodlecoent": {
      "command": "node",
      "args": [
        "${WORKSPACE_DIR}/mcp-servers/mcp-notion-server/build/index.js",
        "--enabledTools=notion_retrieve_page,notion_query_database,notion_retrieve_block_children,notion_append_block_children,notion_create_database_item,notion_search"
      ],
      "env": {
        "NOTION_API_TOKEN": "${NOTION_API_TOKEN}",
        "NOTION_MARKDOWN_CONVERSION": "true"
      }
    },
    "notion-konsigo": {
      "disabled": true,
      "command": "node",
      "args": [
        "${WORKSPACE_DIR}/mcp-servers/mcp-notion-server/build/index.js",
        "--enabledTools=notion_retrieve_page,notion_query_database,notion_append_block_children,notion_update_page_properties,notion_create_database_item,notion_search,notion_retrieve_block,notion_retrieve_block_children,notion_retrieve_database"
      ],
      "env": {
        "NOTION_API_TOKEN": "${NOTION_KONSIGO_TOKEN}",
        "NOTION_MARKDOWN_CONVERSION": "true"
      }
    },
    "gmail": {
      "command": "node",
      "args": [
        "${WORKSPACE_DIR}/mcp-servers/Gmail-MCP-Server/dist/index.js",
        "--enabledTools=search_emails,read_email,draft_email,send_email,modify_email,list_email_labels,download_attachment"
      ],
      "env": {
        "GMAIL_OAUTH_RODLECOENT": "${HOME}/.gmail-mcp-rodlecoent/gcp-oauth.keys.json",
        "GMAIL_CREDENTIALS_RODLECOENT": "${HOME}/.gmail-mcp-rodlecoent/credentials.json",
        "GMAIL_OAUTH_RODOLPHE": "${HOME}/.gmail-mcp-rodolphe/gcp-oauth.keys.json",
        "GMAIL_CREDENTIALS_RODOLPHE": "${HOME}/.gmail-mcp-rodolphe/credentials.json"
      }
    },
    "memory-service": {
      "command": "${WORKSPACE_DIR}/mcp-servers/mcp-memory-service/.venv/bin/python",
      "args": [
        "-m",
        "mcp_memory_service.server_impl",
        "--enabledTools=store_memory,retrieve_memory,search_by_tag,cleanup_duplicates,check_database_health"
      ],
      "env": {
        "MCP_MEMORY_CHROMA_PATH": "${HOME}/.claude/memory-chroma",
        "MCP_MEMORY_BACKUPS_PATH": "${HOME}/.claude/memory-backups",
        "MCP_CONSOLIDATION_ENABLED": "true",
        "MCP_SCHEDULE_DAILY": "03:00",
        "MCP_SCHEDULE_WEEKLY": "SUN 04:00",
        "MCP_SCHEDULE_MONTHLY": "01 05:00",
        "MCP_RETENTION_CRITICAL": "365",
        "MCP_RETENTION_REFERENCE": "180",
        "MCP_RETENTION_STANDARD": "90",
        "MCP_RETENTION_TEMPORARY": "30"
      }
    },
    "gcal": {
      "command": "node",
      "args": [
        "${WORKSPACE_DIR}/mcp-servers/google-calendar-mcp/build/index.js",
        "--enable-tools",
        "list-events,create-event,update-event,get-current-time"
      ],
      "env": {
        "GOOGLE_OAUTH_CREDENTIALS": "${HOME}/.gcal-mcp/oauth.keys.json",
        "GOOGLE_CALENDAR_MCP_TOKEN_PATH": "${HOME}/.gcal-mcp/tokens.json"
      }
    },
    "mcp-raycast-clipboard": {
      "disabled": true,
      "command": "bun",
      "args": ["run", "${WORKSPACE_DIR}/mcp-servers/mcp-raycast-clipboard/src/index.ts"]
    }
  }
}

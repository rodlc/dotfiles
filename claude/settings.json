{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-5-20251101",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-5-20250929"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Glob",
      "Grep",
      "Bash(find|grep|wc|stat|ls|cat|head|tail|echo|basename|dirname|date|pwd:*)",
      "mcp__notion__notion_search",
      "mcp__notion__notion_retrieve_database",
      "mcp__notion__notion_query_database",
      "mcp__notion__notion_retrieve_page",
      "mcp__notion__notion_retrieve_block",
      "mcp__notion__notion_retrieve_block_children",
      "mcp__notion__notion_append_block_children",
      "mcp__notion__notion_create_database_item",
      "mcp__notion__notion_update_page_properties",
      "mcp__acp__Read",
      "mcp__acp__BashOutput",
      "mcp__acp__KillShell",
      "mcp__gmail-rodolphe__read_email",
      "mcp__gmail-rodolphe__search_emails",
      "mcp__gmail-rodolphe__draft_email",
      "mcp__gmail-rodlecoent__read_email",
      "mcp__gmail-rodlecoent__search_emails",
      "mcp__gmail-rodlecoent__draft_email",
      "mcp__memory-service",
      "mcp__mcp-raycast-clipboard"
    ],
    "deny": [
      "Bash(rm -rf|sudo|chmod 777:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/*)",
      "Read(**/credentials.yml.enc)",
      "Read(**/config/master.key)",
      "Read(**/.git/config)",
      "Read(**/id_rsa*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/.ssh/*)",
      "Write(**/credentials.yml.enc)",
      "Write(**/config/master.key)",
      "Bash(git reset --hard|git push -f|git push --force|git clean -f|git branch -D:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/safe-bash.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-approve-skills.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-init.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "alwaysThinkingEnabled": true
}

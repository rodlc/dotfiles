SHELL_SESSIONS_DISABLE=1

# mise shims — active pour toutes les sessions zsh (interactives ET non-interactives)
export PATH="$HOME/.local/share/mise/shims:$PATH"

# Claude Code — privacy hardening (granular, preserves Remote Control)
export DISABLE_ERROR_REPORTING=1
export DISABLE_FEEDBACK_COMMAND=1
export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1

# Playwright — Brave as default browser (playwright-cli + MCP)
export PLAYWRIGHT_MCP_EXECUTABLE_PATH="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"

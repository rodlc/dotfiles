#!/bin/bash
#
# bw-push - Detect local changes and guide user to update Bitwarden
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/.bw-lib.sh"

ensure_rbw

echo "📤 Checking local → Bitwarden sync status..."
echo ""

# === ~/.env sync ===
if [[ ! -f "$ENV_FILE" ]]; then
    echo "⏭️  $ENV_FILE not found. Skipping env sync."
else
    if ! rbw get "$BW_ITEM_SECRETS" &>/dev/null; then
        # Item doesn't exist in Bitwarden
        echo "┌─────────────────────────────────────────────────────────────┐"
        echo "│ 📝 .env : Bitwarden item not found                         │"
        echo "└─────────────────────────────────────────────────────────────┘"
        echo ""
        echo "► Action required:"
        echo "  1. Open Bitwarden app"
        echo "  2. Create a new secure note named '$BW_ITEM_SECRETS'"
        echo "  3. Copy and paste the content from the file below"
        echo ""
        ${EDITOR:-nano} "$ENV_FILE"
    else
        # Compare local vs Bitwarden (rbw sync already called by ensure_rbw above)
        bw_content=$(rbw get "$BW_ITEM_SECRETS" 2>/dev/null)
        local_content=$(cat "$ENV_FILE")

        if [[ "$bw_content" == "$local_content" ]]; then
            echo "✅ .env in sync"
            touch "$HOME/.env.bw-synced"
        else
            echo "┌─────────────────────────────────────────────────────────────┐"
            echo "│ ⚠️  .env : local ≠ Bitwarden                                │"
            echo "└─────────────────────────────────────────────────────────────┘"
            echo ""
            echo "Diff (local vs Bitwarden):"
            diff -u <(echo "$bw_content" | sed 's/=.*/=****/') <(echo "$local_content" | sed 's/=.*/=****/') || true
            echo ""
            echo "► Action required:"
            echo "  1. Review the changes in your editor"
            echo "  2. Copy the content you want to push"
            echo "  3. Open Bitwarden app → '$BW_ITEM_SECRETS' → paste"
            echo ""
            ${EDITOR:-nano} "$ENV_FILE"

            rbw sync 2>/dev/null
            bw_content_after=$(rbw get "$BW_ITEM_SECRETS" 2>/dev/null)
            local_content_after=$(cat "$ENV_FILE")
            if [[ "$bw_content_after" == "$local_content_after" ]]; then
                echo "✅ .env now in sync"
                touch "$HOME/.env.bw-synced"
            else
                echo "⚠️  .env still differs — re-run bw-push after updating Bitwarden"
            fi
        fi
    fi
fi

echo ""

echo ""
echo "✅ Status check complete"


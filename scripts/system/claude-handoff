#!/bin/zsh
#
# claude-handoff - Let Claude Code finish the setup once install.sh has done the deterministic part
#
# install.sh stays the fallback: it covers everything a human must type (sudo, FileVault,
# Bitwarden, gh browser login). Claude takes over what needs judgment.
#
set -euo pipefail

WORKSPACE_DIR="${WORKSPACE_DIR:-$HOME/Code/rodlc/workspace}"
command -v claude >/dev/null && [[ -d "$WORKSPACE_DIR" ]] || exit 0

echo ""
read "go?Hand over to Claude Code to finish the setup? [y/N] "
if [[ ! "$go" =~ ^[Yy]$ ]]; then
  echo "💡 Later: cd $WORKSPACE_DIR && claude, then /login"
  exit 0
fi

machine=$(scutil --get ComputerName)
cd "$WORKSPACE_DIR"
claude "This Mac ($machine) was just bootstrapped with dotfiles install.sh. Finish its setup:
1. Health: SMART status, kernel panics over 7 days, pmset -g log, profiles status -type enrollment (no MDM expected).
2. Validate the install: brew bundle check, bw-status, gh auth status, git config user.email, rtk --version, Terminal default profile, MOTD warnings. Report what failed.
3. Ask me whether to install the MCP tier (./install.sh mcp) and whether this is the reference machine (single-instance services: scheduler, memory HTTP server, backups, WhatsApp).
4. Then look for a setup plan in .claude/plans naming this machine and continue it (its next unchecked actions); never start a second plan for the same machine.
Ask me before any step that needs sudo, a password, a browser login or another machine."

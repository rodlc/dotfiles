# ════════════════════════════════════════════════════════════════════════════
# Core Tools
# ════════════════════════════════════════════════════════════════════════════

# Mozilla CA certificate store
brew "ca-certificates"
# Command-line interface for SQLite
brew "sqlite"
# Cryptography and SSL/TLS Toolkit
brew "openssl@3"
# GitHub command-line tool
brew "gh"
# Distributed revision control system
brew "git"
# Lightweight and flexible command-line JSON processor
brew "jq"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Internet file retriever
brew "wget"
# Provides envsubst
brew "gettext"

# ════════════════════════════════════════════════════════════════════════════
# Shell Environment
# ════════════════════════════════════════════════════════════════════════════

# Zsh plugin manager
brew "antidote"
# Cross-shell prompt
brew "starship"
# Per-directory environment variables
brew "direnv"
# Polyglot version manager
brew "mise"

# ════════════════════════════════════════════════════════════════════════════
# Security Tools
# ════════════════════════════════════════════════════════════════════════════

# Unofficial Bitwarden CLI (Rust)
brew "rbw"
# Official Bitwarden CLI
brew "bitwarden-cli"
# YubiKey manager
brew "ykman"
# GPG pin entry for macOS
brew "pinentry-mac"

# ════════════════════════════════════════════════════════════════════════════
# Media Tools
# ════════════════════════════════════════════════════════════════════════════

# Media player based on MPlayer and mplayer2
brew "mpv"
# Tools and libraries to manipulate images in many formats
brew "imagemagick"
# Perl lib for reading and writing EXIF metadata
brew "exiftool"
# YouTube downloader (used by /yt-transcript skill)
brew "yt-dlp"

# ════════════════════════════════════════════════════════════════════════════
# PDF Tools (minimal — Claude skill handles most cases)
# ════════════════════════════════════════════════════════════════════════════

# PDF rendering library (based on the xpdf-3.0 code base)
brew "poppler"
# Convert HTML to PDF
brew "weasyprint"
# Generic syntax highlighter (required by weasyprint)
brew "pygments"

# ════════════════════════════════════════════════════════════════════════════
# Utilities
# ════════════════════════════════════════════════════════════════════════════

# Select default apps for documents and URL schemes on macOS
brew "duti"
# Ookla speed test
brew "speedtest-cli"
# 7-Zip (high compression file archiver) implementation
brew "p7zip"
# Framework for managing multi-language pre-commit hooks
brew "pre-commit"


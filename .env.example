# Environment variables for development
# This file is automatically copied to ~/.env by install.sh
# Edit ~/.env with your real API keys and secrets

# ========================================
# Paths
# ========================================

# Code directory (used by MCP servers)
CODE_DIR=$HOME/Code

# Workspace directory (contains MCP server submodules)
WORKSPACE_DIR=$HOME/Code/rodlc/workspace
# ========================================
# Claude Code MCP Servers
# ========================================

# GitHub MCP Server
# Scopes: repo, read:org, read:user, workflow, notifications, project, discussion, gist
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=ghp_xxxxx

# Slack MCP Server (mode stealth - browser tokens)
# Extract from browser: see https://github.com/korotovsky/slack-mcp-server/docs/01-authentication-setup.md
SLACK_XOXC_TOKEN=xoxc-xxxxx
SLACK_XOXD_TOKEN=xoxd-xxxxx

# Gmail MCP Server - primary account
# GCP Project: <your-gcp-project-id>
# OAuth credentials from: https://console.cloud.google.com
GMAIL_RODLECOENT_CLIENT_ID=xxxxx.apps.googleusercontent.com
GMAIL_RODLECOENT_CLIENT_SECRET=GOCSPX-xxxxx

# Gmail MCP Server - secondary account
# GCP Project: <your-gcp-project-id>
GMAIL_RODOLPHE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GMAIL_RODOLPHE_CLIENT_SECRET=GOCSPX-xxxxx

# Notion MCP Server (suekou fork)
# Create at: https://www.notion.so/my-integrations
NOTION_API_TOKEN=ntn_xxxxx

# ========================================
# Other Services
# ========================================

# Anthropic API key (if needed)
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ========================================
# Git Identity
# ========================================
# Used by install.sh to generate ~/.config/git/config-identity
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=your-email@example.com
# Optional: GitHub noreply email for public repos
# GIT_USER_EMAIL=<id>+<username>@users.noreply.github.com

#!/bin/bash
#
# bw-pull - Sync ~/.env from Bitwarden (via rbw)
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/.bw-lib.sh"

force=false
[[ "${1:-}" == "--force" ]] && force=true

ensure_rbw

if ! $force && ! check_freshness; then
    exit 1
fi

echo "📥 Fetching secrets from Bitwarden (via rbw)..."
notes=$(rbw get "$BW_ITEM_SECRETS")

if [[ -z "$notes" ]]; then
    echo "❌ Item '$BW_ITEM_SECRETS' not found or empty"
    exit 1
fi

# Backup existing
if [[ -f "$ENV_FILE" ]]; then
    cp "$ENV_FILE" "$ENV_FILE.bak"
fi

# Write new .env
echo "# Generated by bw-pull - DO NOT EDIT MANUALLY" > "$ENV_FILE"
echo "# Source: Bitwarden item '$BW_ITEM_SECRETS'" >> "$ENV_FILE"
echo "# Synced: $(date -Iseconds)" >> "$ENV_FILE"
echo "" >> "$ENV_FILE"

# Add export prefix to all VAR=value lines
echo "$notes" | while IFS= read -r line; do
    if [[ "$line" =~ ^[A-Z_][A-Z0-9_]*= ]]; then
        echo "export $line"
    else
        echo "$line"
    fi
done >> "$ENV_FILE"

chmod 600 "$ENV_FILE"
touch "$HOME/.env.bw-synced"

echo "✅ ~/.env synced ($(wc -l < "$ENV_FILE") lines)"
source "$ENV_FILE"

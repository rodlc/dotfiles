#!/bin/bash
#
# bw-push - Sync local → Bitwarden (env + SSH)
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/.bw-lib.sh"

ensure_rbw

echo "📤 Syncing local → Bitwarden..."
echo ""

# === ~/.env sync ===
if [[ ! -f "$ENV_FILE" ]]; then
    echo "⚠️  $ENV_FILE not found. Skipping env sync."
else
    if ! rbw get "$BW_ITEM_SECRETS" &>/dev/null; then
        # Create new
        echo "📝 Creating '$BW_ITEM_SECRETS' in Bitwarden..."
        local_content=$(cat "$ENV_FILE")
        if rbw_create_notes "$BW_ITEM_SECRETS" "$local_content"; then
            echo "✅ '$BW_ITEM_SECRETS' created"
        else
            echo "❌ Failed to create '$BW_ITEM_SECRETS'"
        fi
    else
        # Compare and update if different
        bw_content=$(rbw get "$BW_ITEM_SECRETS" 2>/dev/null)
        local_content=$(cat "$ENV_FILE")

        if [[ "$bw_content" == "$local_content" ]]; then
            echo "✅ ~/.env in sync"
        else
            echo "⚠️  ~/.env CONFLICT: local ≠ Bitwarden"
            echo ""
            read -p "[O]verwrite Bitwarden / [S]kip / [D]iff ? " choice
            case "$choice" in
                [Oo]*)
                    if rbw_edit_notes "$BW_ITEM_SECRETS" "$local_content"; then
                        echo "✅ Bitwarden updated"
                    else
                        echo "❌ Failed to update Bitwarden"
                    fi
                    ;;
                [Dd]*)
                    diff -u <(echo "$bw_content") <(echo "$local_content") || true
                    echo ""
                    read -p "[O]verwrite Bitwarden / [S]kip ? " choice2
                    case "$choice2" in
                        [Oo]*)
                            if rbw_edit_notes "$BW_ITEM_SECRETS" "$local_content"; then
                                echo "✅ Bitwarden updated"
                            else
                                echo "❌ Failed to update Bitwarden"
                            fi
                            ;;
                        *)
                            echo "⏭️  Skipped"
                            ;;
                    esac
                    ;;
                *)
                    echo "⏭️  Skipped"
                    ;;
            esac
        fi
    fi
fi

echo ""

# === SSH key sync ===
SSH_KEY="$HOME/.ssh/id_ed25519"
SSH_PUB="$HOME/.ssh/id_ed25519.pub"
if [[ ! -f "$SSH_KEY" ]]; then
    echo "⚠️  $SSH_KEY not found. Skipping SSH sync."
else
    if ! rbw get "$BW_ITEM_SSH" &>/dev/null; then
        # Create new SSH Key
        echo "🔑 Creating '$BW_ITEM_SSH' in Bitwarden..."
        private_key=$(cat "$SSH_KEY")

        if rbw_create_notes "$BW_ITEM_SSH" "$private_key"; then
            echo "✅ '$BW_ITEM_SSH' created"
        else
            echo "❌ Failed to create '$BW_ITEM_SSH'"
        fi
    else
        # Compare and update if different
        bw_key=$(rbw get "$BW_ITEM_SSH" 2>/dev/null)
        local_key=$(cat "$SSH_KEY")

        if [[ "$bw_key" == "$local_key" ]]; then
            echo "✅ SSH key in sync"
        else
            echo "⚠️  SSH key CONFLICT: local ≠ Bitwarden"
            local_fp=$(ssh-keygen -lf "$SSH_KEY" 2>/dev/null | awk '{print $2}')

            if [[ -n "$bw_key" ]]; then
                bw_fp=$(echo "$bw_key" | ssh-keygen -lf /dev/stdin 2>/dev/null | awk '{print $2}')
            else
                bw_fp="(empty)"
            fi

            echo "   Local:     $local_fp"
            echo "   Bitwarden: $bw_fp"
            echo ""
            read -p "[O]verwrite Bitwarden / [S]kip ? " choice
            case "$choice" in
                [Oo]*)
                    private_key=$(cat "$SSH_KEY")
                    if rbw_edit_notes "$BW_ITEM_SSH" "$private_key"; then
                        echo "✅ Bitwarden updated"
                    else
                        echo "❌ Failed to update Bitwarden"
                    fi
                    ;;
                *)
                    echo "⏭️  Skipped"
                    ;;
            esac
        fi
    fi
fi

touch "$HOME/.env.bw-synced"
echo ""
echo "✅ Sync complete"

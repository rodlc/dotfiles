#!/bin/bash
#
# bw-status - Check Bitwarden sync status (via rbw)
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/.bw-lib.sh"

ensure_rbw

echo "📊 Bitwarden Sync Status"
echo ""
echo "┌──────────────┬────────────────┬────────────────┬──────────┐"
echo "│ Item         │ Bitwarden      │ Local          │ Sync     │"
echo "├──────────────┼────────────────┼────────────────┼──────────┤"

# === .env ===
bw_env="no"
local_env="no"
sync_env="n/a"

if rbw get "$BW_ITEM_SECRETS" &>/dev/null; then
    bw_env="yes"
fi

if [[ -f "$ENV_FILE" ]]; then
    local_env="yes"
fi

if [[ "$bw_env" == "yes" && "$local_env" == "yes" ]]; then
    bw_content=$(rbw get "$BW_ITEM_SECRETS" 2>/dev/null)
    local_content=$(cat "$ENV_FILE")
    if [[ "$bw_content" == "$local_content" ]]; then
        sync_env="ok"
    else
        sync_env="DIFF"
    fi
fi

printf "│ %-12s │ %-14s │ %-14s │ %-8s │\n" ".env" "$bw_env" "$local_env" "$sync_env"

# === SSH Keys ===
for i in "${!SSH_BW_NAMES[@]}"; do
    bw_name="${SSH_BW_NAMES[$i]}"
    ssh_key="${SSH_LOCAL_PATHS[$i]}"
    bw_ssh="no"
    local_ssh="no"
    sync_ssh="n/a"

    if rbw get "$bw_name" &>/dev/null; then
        bw_ssh="yes"
    fi

    if [[ -f "$ssh_key" ]]; then
        local_ssh="yes"
    fi

    if [[ "$bw_ssh" == "yes" && "$local_ssh" == "yes" ]]; then
        bw_key=$(rbw get "$bw_name" 2>/dev/null)
        local_key=$(cat "$ssh_key")
        if [[ "$bw_key" == "$local_key" ]]; then
            sync_ssh="ok"
        else
            sync_ssh="DIFF"
        fi
    fi

    printf "│ %-12s │ %-14s │ %-14s │ %-8s │\n" "$bw_name" "$bw_ssh" "$local_ssh" "$sync_ssh"
done

echo "└──────────────┴────────────────┴────────────────┴──────────┘"
echo ""
echo "Legend: ok = in sync  DIFF = out of sync  n/a = cannot compare"
echo ""
echo "Run 'bw-push' to update Bitwarden or 'bw-pull' to update local"

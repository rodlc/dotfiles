Host *
  UseKeychain yes
  AddKeysToAgent yes

# Personal (rodlc)
Host github.com-rodlc
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# Work (rodlcmagic)
Host github.com-rodlcmagic
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_work
  IdentitiesOnly yes

# Default fallback (personal)
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

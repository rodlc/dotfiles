# Git helper — default branch name
_git_default_branch() {
  command git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | cut -d'/' -f4
}

# Git wrapper - Alert if main is behind origin before checkout
git() {
  if [[ "$1" =~ ^(checkout|co|switch)$ ]]; then
    command git fetch --quiet 2>/dev/null
    local default_branch=$(_git_default_branch)
    default_branch=${default_branch:-main}
    local behind=$(command git rev-list --count $default_branch..origin/$default_branch 2>/dev/null)
    [[ "$behind" -gt 0 ]] && echo "⚠️  \033[1;33m$default_branch\033[0m behind by \033[1;31m$behind\033[0m"
  fi
  command git "$@"
}

# Checkout main (uses wrapper with alert)
gm() {
  git checkout "$(_git_default_branch || echo main)"
}

# Clean merged branches
gcleanup() {
  local db=$(_git_default_branch)
  db="${db:-main}"
  git checkout "$db" && git pull origin "$db" && git fetch -p && \
    command git branch --merged | grep -vE "^\*|$db" | xargs -n1 git branch -d
}

# Full cleanup: merged branches + gone remotes
gpurge() {
  local db=$(_git_default_branch)
  db="${db:-main}"
  git checkout "$db" && git pull origin "$db" && git fetch -p && \
    command git branch --merged | grep -vE "^\*|$db" | xargs -n1 git branch -d && \
    command git branch -vv | grep ': gone]' | awk '{sub(/^[+* ]/, ""); print $1}' | xargs -r git branch -D
}

# Git worktree — Shell-only aliases (parallel branches in separate dirs)
# Claude uses EnterWorktree instead → .claude/worktrees/ (branch-aware, named)
wt-new() {
  [[ -z "$1" ]] && echo "Usage: wt-new <branch>" && return 1
  local repo=$(basename "$(git rev-parse --show-toplevel)")
  local target="../${repo}-$1"
  git worktree add "$target" -b "$1" && echo "✅ Worktree: $target" && cd "$target"
}

wt-from() {
  [[ -z "$1" ]] && echo "Usage: wt-from <existing-branch>" && return 1
  local repo=$(basename "$(git rev-parse --show-toplevel)")
  local target="../${repo}-$1"
  git worktree add "$target" "$1" && echo "✅ Worktree: $target" && cd "$target"
}

wt-list() { git worktree list; }

wt-rm() {
  [[ -z "$1" ]] && echo "Usage: wt-rm <branch>" && return 1
  local repo=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || git rev-parse --show-toplevel)")
  git worktree remove "../${repo}-$1" && echo "🗑️  Removed ${repo}-$1"
}

wt-clean() {
  git worktree list | tail -n +2 | awk '{print $1}' | while read wt; do
    git worktree remove "$wt" && echo "🗑️  Removed $wt"
  done
}

# ============================================================================
# Claude Code Monitoring
# ============================================================================
alias cc='claude'

ccw() {
  local repo adj noun
  repo=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")
  local adjs=(aqua azure bold bright calm clean clear cool coral crisp dark deep dense dry fast firm flat free glad gold grand grey hard high hot huge icy jade jolly keen kind lazy lime lush mild mute neat new pale pink pure red rich rose royal safe sage sharp slim slow soft stark still swift teal trim vast vivid warm wide wild wise)
  local nouns=(ant ape ark bat bay bee brook cat cave cliff cod cove crab cub dale doe dune eel elk fell fen finch fly ford fox glen gnu gorge grove hawk hen hill ibis isle jay kite knoll lake lamb lark ledge loch marsh mere mole moor newt nook owl ox peak pig pond pup ram rat reef ridge rock seal shoal sky slope swan toad tor vale vole wren yak zebra)
  # NOTE: zsh 1-indexed arrays — not bash-compatible
  adj=${adjs[$((RANDOM % ${#adjs[@]} + 1))]}
  noun=${nouns[$((RANDOM % ${#nouns[@]} + 1))]}
  claude -w "${repo}-${adj}-${noun}" --name "${repo}" "$@"
}
alias cc-global='npx ccusage@latest'
alias cc-live='npx ccusage blocks --live'
alias cc-daily='npx ccusage daily'
alias cc-monthly='npx ccusage monthly'
alias ccost='npx ccusage daily --breakdown'
alias ccc='claude --continue'
alias ccr='claude --resume'
alias ccp='claude -p'


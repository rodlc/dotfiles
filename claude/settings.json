{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_TMPDIR": "/var/folders/qw/4d71_ssj61s671zf9wqv_3f80000gn/T/claude"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "Bash(npm|yarn|pnpm:*)",
      "Bash(python*:*)",
      "Bash(node:*)",
      "Bash(magick|exiftool|weasyprint:*)",
      "Bash(find|grep|wc|stat|ls|cat|head|tail|echo|basename|dirname|date|pwd:*)",
      "mcp__memory-service__*",
      "mcp__notion-rodlecoent__*",
      "mcp__notion-alfec__*",
      "mcp__gmail__*",
      "mcp__gcal__*",
      "mcp__mcp-raycast-clipboard__*"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(chmod 777:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Read(//.env)",
      "Read(~/.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/*)",
      "Read(//**/.ssh/*)",
      "Read(**/credentials.yml.enc)",
      "Read(**/config/master.key)",
      "Read(**/.git/config)",
      "Read(~/id_rsa*)",
      "Read(**/id_rsa*)",
      "Write(//.env)",
      "Write(~/.env)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(~/.ssh/*)",
      "Write(//**/.ssh/*)",
      "Write(**/credentials.yml.enc)",
      "Write(**/config/master.key)"
    ],
    "defaultMode": "plan"
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/safe-bash.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-approve-skills.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-init.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/user-prompt-context.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "alwaysThinkingEnabled": false
}

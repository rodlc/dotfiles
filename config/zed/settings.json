{
  "edit_predictions": {
    "provider": "copilot"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "theme": {
    "mode": "dark",
    "light": "Nord Dark",
    "dark": "Nord Dark"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "JetBrains Mono",
  "scrollbar": {
    "show": "never"
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "base_keymap": "VSCode",
  "vim_mode": false,
  "relative_line_numbers": "disabled",
  "cursor_blink_mode": "terminal",
  "agent": {
    "favorite_models": [],
    "default_profile": "write",
    "model_parameters": []
  },
  "agent_servers": {
    "claude": {
      "default_config_options": {
        "mode": "plan"
      }
    },
    "claude-acp": {
      "type": "registry",
      "default_mode": "plan",
      "default_model": "opusplan",
      "default_config_options": {
        "approval_mode": "auto-edit"
      }
    }
  },
  "languages": {
    "Ruby": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2
    },
    "Erb": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "dock": "bottom",
    "font_size": 14
  }
}

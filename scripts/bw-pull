#!/bin/bash
#
# bw-pull - Sync Bitwarden → local (env + SSH)
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/.bw-lib.sh"

# Use rbw for env (faster), bw for SSH (needs JSON parsing)
ensure_rbw

echo "📥 Syncing Bitwarden → local..."
echo ""

# === ~/.env sync ===
if ! rbw get "$BW_ITEM_SECRETS" &>/dev/null; then
    echo "⚠️  '$BW_ITEM_SECRETS' not found in Bitwarden"
else
    bw_content=$(rbw get "$BW_ITEM_SECRETS")

    if [[ ! -f "$ENV_FILE" ]]; then
        # Restore from Bitwarden
        echo "📝 Restoring ~/.env from Bitwarden..."
        echo "$bw_content" > "$ENV_FILE"
        chmod 600 "$ENV_FILE"
        echo "✅ ~/.env restored"
    else
        local_content=$(cat "$ENV_FILE")
        if [[ "$bw_content" == "$local_content" ]]; then
            echo "✅ ~/.env in sync"
        else
            echo "⚠️  ~/.env CONFLICT: Bitwarden ≠ local"
            echo ""
            read -p "[O]verwrite local / [S]kip / [D]iff ? " choice
            case "$choice" in
                [Oo]*)
                    cp "$ENV_FILE" "$ENV_FILE.backup.$(date +%Y%m%d)"
                    echo "$bw_content" > "$ENV_FILE"
                    echo "✅ Local updated (backup saved)"
                    ;;
                [Dd]*)
                    diff -u <(echo "$local_content") <(echo "$bw_content") || true
                    ;;
                *)
                    echo "⏭️  Skipped"
                    ;;
            esac
        fi
    fi
fi

echo ""

# === SSH key sync ===
# Use bw CLI for SSH to handle type 4 (sshKey) format
ensure_unlocked_bw

SSH_KEY="$HOME/.ssh/id_ed25519"
SSH_PUB="$HOME/.ssh/id_ed25519.pub"

if ! bw get item "$BW_ITEM_SSH" &>/dev/null; then
    echo "⚠️  '$BW_ITEM_SSH' not found in Bitwarden"
else
    ssh_item=$(bw get item "$BW_ITEM_SSH")
    item_type=$(echo "$ssh_item" | jq -r .type)

    # Extract private key based on type
    if [[ "$item_type" == "4" ]]; then
        bw_key=$(echo "$ssh_item" | jq -r '.sshKey.privateKey // empty')
        bw_pub=$(echo "$ssh_item" | jq -r '.sshKey.publicKey // empty')
    else
        bw_key=$(echo "$ssh_item" | jq -r '.notes // empty')
        bw_pub=""
    fi

    if [[ -z "$bw_key" ]]; then
        echo "⚠️  SSH private key empty in Bitwarden"
    elif [[ ! -f "$SSH_KEY" ]]; then
        # Restore from Bitwarden
        echo "🔑 Restoring SSH key from Bitwarden..."
        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
        echo "$bw_key" > "$SSH_KEY"
        chmod 600 "$SSH_KEY"

        if [[ -n "$bw_pub" ]]; then
            echo "$bw_pub" > "$SSH_PUB"
        else
            ssh-keygen -y -f "$SSH_KEY" > "$SSH_PUB"
        fi

        ssh-add --apple-use-keychain "$SSH_KEY" 2>/dev/null || true
        echo "✅ SSH key restored"
    else
        local_key=$(cat "$SSH_KEY")
        if [[ "$bw_key" == "$local_key" ]]; then
            echo "✅ SSH key in sync"
        else
            echo "⚠️  SSH key CONFLICT: Bitwarden ≠ local"

            if [[ -n "$bw_key" ]]; then
                bw_fp=$(echo "$bw_key" | ssh-keygen -lf /dev/stdin 2>/dev/null | awk '{print $2}')
            else
                bw_fp="(empty)"
            fi

            local_fp=$(ssh-keygen -lf "$SSH_KEY" 2>/dev/null | awk '{print $2}')
            echo "   Bitwarden: $bw_fp"
            echo "   Local:     $local_fp"
            echo ""
            read -p "[O]verwrite local / [S]kip ? " choice
            case "$choice" in
                [Oo]*)
                    cp "$SSH_KEY" "$SSH_KEY.backup.$(date +%Y%m%d)"
                    echo "$bw_key" > "$SSH_KEY"
                    chmod 600 "$SSH_KEY"

                    if [[ -n "$bw_pub" ]]; then
                        echo "$bw_pub" > "$SSH_PUB"
                    else
                        ssh-keygen -y -f "$SSH_KEY" > "$SSH_PUB"
                    fi

                    ssh-add --apple-use-keychain "$SSH_KEY" 2>/dev/null || true
                    echo "✅ Local updated (backup saved)"
                    ;;
                *)
                    echo "⏭️  Skipped"
                    ;;
            esac
        fi
    fi
fi

echo ""
echo "✅ Sync complete"

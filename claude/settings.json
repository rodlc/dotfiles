{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "Bash(npm|yarn|pnpm:*)",
      "Bash(python*:*)",
      "Bash(node:*)",
      "Bash(magick|exiftool|weasyprint:*)",
      "Bash(bun|bunx:*)",
      "Bash(mise:*)",
      "Bash(ruby|rails|rake|bundle|gem:*)",
      "Bash(jq:*)",
      "Bash(playwright-cli:*)",
      "Bash(yt-dlp:*)",
      "Bash(command -v yt-dlp)",
      "Bash(find|grep|wc|stat|ls|cat|head|tail|echo|basename|dirname|date|pwd:*)",
      "Bash(sqlite3 *mcp-memory*)",
      "Bash(du *mcp-memory*)",
      "Bash(*/sync-memory.sh *)",
      "Bash(curl *127.0.0.1:8000/api/quality*)",
      "mcp__memory-service__*",
      "mcp__notion-rodlecoent__*",
      "mcp__notion-konsigo__*",
      "mcp__gmail__*",
      "mcp__gcal__*",
      "mcp__mcp-raycast-clipboard__*",
      "mcp__playwright__*",
      "mcp__webflow__data_comments_tool",
      "mcp__webflow__ask_webflow_ai",
      "mcp__webflow__webflow_guide_tool",
      "mcp__posthog__*"
    ],
    "deny": [
      "mcp__webflow__*",
      "mcp__webflow__data_sites_tool",
      "mcp__posthog__delete-feature-flag",
      "mcp__posthog__experiment-delete",
      "mcp__posthog__survey-create",
      "mcp__posthog__survey-delete",
      "mcp__posthog__survey-get",
      "mcp__posthog__survey-stats",
      "mcp__posthog__survey-update",
      "mcp__posthog__surveys-get-all",
      "mcp__posthog__surveys-global-stats",
      "mcp__gmail__send_email",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_run_code",
      "Bash(rm -rf:*)",
      "Bash(chmod 777:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Read(//.env)",
      "Read(~/.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/*)",
      "Read(//**/.ssh/*)",
      "Read(**/credentials.yml.enc)",
      "Read(**/config/master.key)",
      "Read(**/.git/config)",
      "Read(~/id_rsa*)",
      "Read(**/id_rsa*)",
      "Write(//.env)",
      "Write(~/.env)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(~/.ssh/*)",
      "Write(//**/.ssh/*)",
      "Write(**/credentials.yml.enc)",
      "Write(**/config/master.key)"
    ],
    "defaultMode": "plan"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/safe-bash.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-approve-skills.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/core/session-start.js",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/core/mid-conversation.js",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/core/session-end.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {}
}

#!/bin/bash
#
# bw-secrets - Unified Bitwarden secrets management
#
# Usage:
#   bw-secrets bootstrap   # First-time setup (create BW items)
#   bw-secrets sync        # Sync ~/.env from Bitwarden
#   bw-secrets status      # Check sync status
#   bw-secrets update      # Update Bitwarden from ~/.env
#
set -euo pipefail

ENV_FILE="$HOME/.env"
BW_ITEM_SECRETS="Dotfiles Env"
BW_ITEM_GPG="MCP Memory GPG"

# ============================================================================
# Core Functions
# ============================================================================

ensure_unlocked() {
    local status=$(bw status | jq -r .status)

    if [[ "$status" == "locked" ]]; then
        echo "🔐 Bitwarden locked. Unlocking..."
        export BW_SESSION=$(bw unlock --raw)
        if [[ $? -ne 0 ]]; then
            echo "❌ Unlock failed"
            exit 1
        fi
        echo "✅ Unlocked"
    elif [[ "$status" == "unauthenticated" ]]; then
        echo "❌ Not logged in. Run: bw login"
        exit 1
    fi
}

check_freshness() {
    local marker="$HOME/.env.bw-synced"
    if [[ -f "$ENV_FILE" && -f "$marker" ]]; then
        if [[ "$ENV_FILE" -nt "$marker" ]]; then
            echo "⚠️  ~/.env modified locally since last sync"
            echo "   Use 'update' to push to Bitwarden, or 'sync --force' to overwrite"
            return 1
        fi
    fi
    return 0
}

# ============================================================================
# Commands
# ============================================================================

cmd_bootstrap() {
    ensure_unlocked

    echo "🔧 Bootstrapping Bitwarden items..."

    # Check if items already exist
    if bw get item "$BW_ITEM_SECRETS" &>/dev/null; then
        echo "⚠️  '$BW_ITEM_SECRETS' already exists. Skipping."
    else
        if [[ ! -f "$ENV_FILE" ]]; then
            echo "❌ $ENV_FILE not found. Create it first."
            exit 1
        fi

        echo "📝 Creating '$BW_ITEM_SECRETS'..."
        ENV_CONTENT=$(cat "$ENV_FILE")
        bw get template item | jq \
            --arg name "$BW_ITEM_SECRETS" \
            --arg notes "$ENV_CONTENT" \
            '.type = 2 | .name = $name | .secureNote = {"type": 0} | .notes = $notes' | \
            bw encode | bw create item > /dev/null
        echo "✅ '$BW_ITEM_SECRETS' created"
    fi

    if bw get item "$BW_ITEM_GPG" &>/dev/null; then
        echo "⚠️  '$BW_ITEM_GPG' already exists. Skipping."
    else
        echo "🔑 Creating '$BW_ITEM_GPG'..."
        PASSPHRASE=$(bw generate -p --words 4 --separator -)
        echo "   Generated passphrase: $PASSPHRASE"

        bw get template item | jq \
            --arg name "$BW_ITEM_GPG" \
            --arg pass "$PASSPHRASE" \
            '.type = 1 | .name = $name | .login = {"password": $pass} | .notes = "GPG passphrase for MCP Memory sync (also stored in ~/.env)"' | \
            bw encode | bw create item > /dev/null

        # Add to ~/.env if not already present
        if [[ -f "$ENV_FILE" ]] && ! grep -q "^GPG_PASSPHRASE=" "$ENV_FILE"; then
            echo "" >> "$ENV_FILE"
            echo "# GPG passphrase for Memory encryption" >> "$ENV_FILE"
            echo "GPG_PASSPHRASE=\"$PASSPHRASE\"" >> "$ENV_FILE"
            echo "✅ '$BW_ITEM_GPG' created and added to ~/.env"
        else
            echo "✅ '$BW_ITEM_GPG' created"
        fi
    fi

    echo ""
    echo "✅ Bootstrap complete!"
}

cmd_sync() {
    local force=false
    [[ "${1:-}" == "--force" ]] && force=true

    ensure_unlocked

    if ! $force && ! check_freshness; then
        return 1
    fi

    echo "📥 Fetching secrets from Bitwarden..."
    local notes
    notes=$(bw get notes "$BW_ITEM_SECRETS")

    if [[ -z "$notes" ]]; then
        echo "❌ Item '$BW_ITEM_SECRETS' not found or empty"
        exit 1
    fi

    # Backup existing
    if [[ -f "$ENV_FILE" ]]; then
        cp "$ENV_FILE" "$ENV_FILE.bak"
    fi

    # Write new .env
    echo "# Generated by bw-secrets - DO NOT EDIT MANUALLY" > "$ENV_FILE"
    echo "# Source: Bitwarden item '$BW_ITEM_SECRETS'" >> "$ENV_FILE"
    echo "# Synced: $(date -Iseconds)" >> "$ENV_FILE"
    echo "" >> "$ENV_FILE"
    echo "$notes" >> "$ENV_FILE"

    # Add GPG passphrase if item exists
    if bw get item "$BW_ITEM_GPG" &>/dev/null; then
        local gpg_pass
        gpg_pass=$(bw get password "$BW_ITEM_GPG")

        if [[ -n "$gpg_pass" ]]; then
            echo "" >> "$ENV_FILE"
            echo "# GPG passphrase for Memory encryption" >> "$ENV_FILE"
            echo "GPG_PASSPHRASE=\"$gpg_pass\"" >> "$ENV_FILE"
        fi
    fi

    chmod 600 "$ENV_FILE"
    touch "$HOME/.env.bw-synced"

    echo "✅ ~/.env synced ($(wc -l < "$ENV_FILE") lines)"
}

cmd_update() {
    ensure_unlocked

    if [[ ! -f "$ENV_FILE" ]]; then
        echo "❌ $ENV_FILE not found"
        exit 1
    fi

    echo "📤 Updating Bitwarden from ~/.env..."

    # Get item ID
    local item_id=$(bw get item "$BW_ITEM_SECRETS" | jq -r .id)
    if [[ -z "$item_id" || "$item_id" == "null" ]]; then
        echo "❌ Item '$BW_ITEM_SECRETS' not found"
        exit 1
    fi

    # Get current item
    local item=$(bw get item "$item_id")

    # Update notes field
    local updated=$(echo "$item" | jq --arg notes "$(cat "$ENV_FILE")" '.secureNote.type = 0 | .notes = $notes')

    # Encode and update
    echo "$updated" | bw encode | bw edit item "$item_id" > /dev/null

    touch "$HOME/.env.bw-synced"
    echo "✅ Bitwarden updated"
}

cmd_status() {
    local marker="$HOME/.env.bw-synced"

    if [[ -f "$marker" ]]; then
        echo "Last sync: $(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$marker")"

        if [[ -f "$ENV_FILE" && "$ENV_FILE" -nt "$marker" ]]; then
            echo "⚠️  ~/.env modified since last sync"
        fi
    else
        echo "Never synced"
    fi

    echo ""
    ensure_unlocked

    if bw get item "$BW_ITEM_SECRETS" &>/dev/null; then
        echo "✅ '$BW_ITEM_SECRETS' exists in Bitwarden"
    else
        echo "❌ '$BW_ITEM_SECRETS' not found. Run: bw-secrets bootstrap"
    fi

    if bw get item "$BW_ITEM_GPG" &>/dev/null; then
        echo "✅ '$BW_ITEM_GPG' exists in Bitwarden"
    else
        echo "❌ '$BW_ITEM_GPG' not found. Run: bw-secrets bootstrap"
    fi
}

# ============================================================================
# Main
# ============================================================================

case "${1:-help}" in
    bootstrap)
        cmd_bootstrap
        ;;
    sync)
        cmd_sync "${2:-}"
        ;;
    update)
        cmd_update
        ;;
    status)
        cmd_status
        ;;
    help|--help|-h)
        echo "Usage: bw-secrets <command>"
        echo ""
        echo "Commands:"
        echo "  bootstrap   First-time setup (create Bitwarden items)"
        echo "  sync        Sync ~/.env from Bitwarden"
        echo "  update      Update Bitwarden from ~/.env"
        echo "  status      Check sync status"
        echo ""
        echo "Examples:"
        echo "  bw-secrets bootstrap        # First-time setup"
        echo "  bw-secrets sync             # Pull from Bitwarden"
        echo "  bw-secrets sync --force     # Force overwrite local"
        echo "  bw-secrets update           # Push to Bitwarden"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'bw-secrets help' for usage"
        exit 1
        ;;
esac
